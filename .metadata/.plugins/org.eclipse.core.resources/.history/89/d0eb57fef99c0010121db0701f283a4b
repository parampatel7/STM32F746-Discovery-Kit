CC = arm-none-eabi-gcc
OBJCOPY = arm-none-eabi-objcopy
CFLAGS = -mcpu=cortex-m7 -mthumb -Wall -g -O0 -Iinc
LDFLAGS = -Tstm32f746.ld

SRCS = main.c startup_stm32f746xx.s

all: main.bin

main.elf: $(SRCS)
	$(CC) $(CFLAGS) $(SRCS) -o $@ $(LDFLAGS)

main.bin: main.elf
	$(OBJCOPY) -O binary $< $@

clean:
	rm -f *.o *.elf *.bin
