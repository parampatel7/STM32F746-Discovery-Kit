/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  /* USER CODE BEGIN 2 */
  uart_init();
  // Blink LED or set flag
  if(blink_flag)
	  {
	  	  for (int i = 0; i < 5; i++)
	  	  	  {
	  		  	  GPIOH->ODR |= (1 << 8);
	  		  	  HAL_Delay(1000);
	  		  	  GPIOH->ODR &= ~(1 << 8);
	  		  	  HAL_Delay(1000);
	  	  	  }
	  	  blink_flag=0;
	  }

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */
	  GPIOH->ODR &= ~(1 << 8);
	  char msg[] = "Hello from USART6\r\n";
	  for (int i = 0; msg[i] != '\0'; i++)
	  {
	     while (!(USART6->ISR & USART_ISR_TXE));  // Wait until TX is empty
	     USART6->TDR = msg[i];                    // Send character
	  }
	  while (!(USART6->ISR & USART_ISR_TC));       // Transmission complete

	  for (volatile int i = 0; i < 500000; i++);

	  if (USART6->ISR & USART_ISR_RXNE)  // If data received
	  {
	      char c = USART6->RDR;          // Read received data
	      while (!(USART6->ISR & USART_ISR_TXE));
	      USART6->TDR = c;
	  }
	  HAL_Delay(10000);
	  /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

