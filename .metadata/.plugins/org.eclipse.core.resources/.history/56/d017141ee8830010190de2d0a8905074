/* USER CODE BEGIN 4 */
void uart_init(void)
{
		RCC->APB2ENR |= RCC_APB2ENR_USART6EN; // Enable USART6 clock
		USART6->CR1 &= ~USART_CR1_UE; // DISABLE UART BEFORE CONFIGURATION

		USART6->CR1 &= ~USART_CR1_M1 ; //SET FOR 8BIT COMMUNICATION
		USART6-> CR1 &= ~USART_CR1_M0;

		USART6->CR1 |= USART_CR1_OVER8; //OVERSAMPLING BY 16
		USART6-> CR1 &= ~USART_CR1_PCE; //PARITY CONTROL BIT DISABLE
		USART6->CR2 &= ~USART_CR2_STOP; //1 STOP BIT

	    // Baud rate setup (assuming 108 MHz APB2 clock due to PLL settings)
	    // USARTDIV = USARTDIV = Fck / (8 * BaudRate)
		//    					= 108,000,000 / (8 * 115200)
		//						≈ 117.1875
	    // Mantissa = 117
		// Fraction = 0.1875 * 8 = 1.5 ≈ 2
		// BRR = (117 << 4) + 2 = 0x752
	    USART6->BRR = 0x752;
	    USART6->CR1 |= USART_CR1_TE;  // Transmitter enable
	    USART6->CR1 |= USART_CR1_RE;  // Receiver enable

	//    USART6->CR1 |= USART_CR1_TCIE;  // Enable TC interrupt
	    NVIC_EnableIRQ(USART6_IRQn);

	    USART6->CR1 |= USART_CR1_UE; // ENABLE USART


}

void USART6_IRQHandler(void)
{
    if (USART6->ISR & USART_ISR_TC)
    {
        USART6->ICR |= USART_ICR_TCCF; // Clear interrupt flag
        blink_flag=1;
    }
}

