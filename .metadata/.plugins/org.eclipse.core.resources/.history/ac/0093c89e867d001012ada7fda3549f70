  * @retval None
  */
void ADC_IRQHandler(void)
{
    if (ADC1->SR & ADC_SR_EOC)
    {
        data = ADC1->DR & 0xFFF;  // Read 12-bit result
        ADC1->SR &= ~ADC_SR_EOC;  // Clear EOC flag
        GPIOD->ODR |= (1U << 6);
        adc_conversion_complete = 1; // Signal to main loop

    }
}
void adc_init(void)
{	ADC1->SR = 0;  // Clear all status flags
    RCC->APB2ENR |= RCC_APB2ENR_ADC1EN;
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;
    GPIOA->MODER |= (3U << (4 * 2)); // Analog mode for PA4

    ADC123_COMMON->CCR |= (1U << 16);  //PCLK DIVIDE BY 4
    ADC123_COMMON-> CCR |= (15U << 8); //DELAY BETWEEN 2 SAMPLING PHRASES
	ADC1->CR1 &= ~(3U << 24); //resolution 12bit
	ADC1->CR1 |= (1U << 8);   //scan mode enabled


	//ADC1->CR2 |= ADC_CR2_ALIGN; //LEFT ALIGN DATA, ADC result is placed in bits [15:4] of ADC1->DR for 12bit resolution
	ADC1->CR2 &= ~ADC_CR2_ALIGN;     // Right-align
 	ADC1->CR2 |= ADC_CR2_EOCS; // Enable EOC selection — interrupt after each conversion
//	ADC1->CR2 &= ~ADC_CR2_CONT; // Make sure it's single conversion mode
	ADC1->SMPR2 |= (7U << 12); //480 CHANNEL SAMPLING CYCLES SET, how long ADC samples input voltage before converting it
    ADC1->SQR3 = 4U;
    /*Because a conversion sequence can include up to 16 channels,
     * and each SQR register holds multiple 5-bit fields (each field represents a channel number), STM32 splits them:
SQR3: channels 1–6
SQR2: channels 7–12
SQR1: channels 13–16 + number of conversions
SQR registers configure the order of regular ADC conversions.
ADC1->SQR3 = 4U; sets channel 4 as the first to convert.*/

	ADC1->CR1 |= ADC_CR1_EOCIE; // Enable End of Conversion Interrupt
    NVIC_EnableIRQ(ADC_IRQn);    // Enable ADC interrupt in NVIC
    NVIC_SetPriority(ADC_IRQn, 1);
}
void gpio_init(void)
{
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN ;
	GPIOA->MODER |= (3U << 8); // PA4 to analog mode
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIODEN;

	// Set PD6 to general purpose output mode (MODER = 01)
	GPIOD->MODER &= ~(3U << (6 * 2)); // Clear bits
	GPIOD->MODER |=  (1U << (6 * 2)); // Set bit 12 to 1, bit 13 to 0

	// Optional: Set output type to push-pull (default)
	GPIOD->OTYPER &= ~(1U << 6);

	// Optional: Set output speed (e.g., high speed)
	GPIOD->OSPEEDR |= (3U << (6 * 2));

	// Optional: No pull-up/pull-down
	GPIOD->PUPDR &= ~(3U << (6 * 2));
}
