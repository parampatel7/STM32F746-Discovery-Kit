/**
  ******************************************************************************
  * @file           : tcpClientRAW.c
  * @brief          : TCP Client implementation using LwIP RAW API
  ******************************************************************************
  * This TCP Client implementation follows the same structure as tcpServerRAW.c
  * for educational purposes. It demonstrates:
  *
  * CLIENT WORKFLOW:
  * 1. Create TCP PCB (Protocol Control Block)
  * 2. Connect to remote server (instead of bind+listen like server)
  * 3. Handle connection callbacks
  * 4. Send/receive data
  * 5. Handle errors and reconnection
  *
  * KEY DIFFERENCES FROM SERVER:
  * - Server uses: tcp_new() -> tcp_bind() -> tcp_listen() -> tcp_accept()
  * - Client uses: tcp_new() -> tcp_connect() -> callbacks
  ******************************************************************************
  */

#include "tcpClientRAW.h"
#include "lwip/tcp.h"
#include "lwip/err.h"
#include "lwip/sys.h"
#include "lwip/netif.h"
#include "lwip/timeouts.h"
#include "string.h"
#include <stdio.h>

/* Reference to the global network interface created in lwip.c */
extern struct netif gnetif;

/* Protocol states - similar to server but for client perspective -----------*/
enum tcp_client_states
{
  ES_NONE = 0,        /* Initial state, not connected */
  ES_CONNECTING,      /* Connection attempt in progress */
  ES_CONNECTED,       /* Successfully connected to server */
  ES_RECEIVED,        /* Data received from server */
  ES_CLOSING          /* Connection closing */
};

/* Structure for maintaining connection info ---------------------------------*/
/* This is similar to tcp_server_struct but for client side */
struct tcp_client_struct
{
  u8_t state;             /* Current connection state */
  u8_t retries;           /* Number of connection retries */
  struct tcp_pcb *pcb;    /* Pointer to the TCP PCB */
  struct pbuf *p;         /* Pointer to received/transmitted pbuf */
};

/* Static (global) client structure ------------------------------------------*/
/* Unlike server which creates new structure for each client,
   TCP client typically has only one connection */
static struct tcp_client_struct *es_client = NULL;

/* Private function prototypes -----------------------------------------------*/
static err_t tcp_client_connected(void *arg, struct tcp_pcb *tpcb, err_t err);
static err_t tcp_client_recv(void *arg, struct tcp_pcb *tpcb, struct pbuf *p, err_t err);
static void tcp_client_error(void *arg, err_t err);
static err_t tcp_client_poll(void *arg, struct tcp_pcb *tpcb);
static err_t tcp_client_sent(void *arg, struct tcp_pcb *tpcb, u16_t len);
static void tcp_client_send(struct tcp_pcb *tpcb, struct tcp_client_struct *es);
static void tcp_client_connection_close(struct tcp_pcb *tpcb, struct tcp_client_struct *es);
static void tcp_client_handle(struct tcp_pcb *tpcb, struct tcp_client_struct *es);

/* Helper function to get state name string ----------------------------------*/
static const char* get_client_state_name(u8_t state)
{
  switch(state)
  {
    case ES_NONE:       return "ES_NONE";
    case ES_CONNECTING: return "ES_CONNECTING";
    case ES_CONNECTED:  return "ES_CONNECTED";
    case ES_RECEIVED:   return "ES_RECEIVED";
    case ES_CLOSING:    return "ES_CLOSING";
    default:            return "UNKNOWN";
  }
}

/**
  * @brief  lwIP timer callback - retries tcp_client_init() until link is UP
  * @note   Called automatically by sys_check_timeouts() every 2 seconds
  */
static void tcp_client_retry_timer(void *arg)
{
  LWIP_UNUSED_ARG(arg);
  printf("[INFO] Retrying TCP connection (link check)...\r\n");
  tcp_client_init();
}

/**
  * @brief  Initialize TCP Client and connect to server
  * @note   This is the main entry point for TCP client
  *
  * KEY FIX: Checks that the Ethernet link is UP before calling tcp_connect().
  * tcp_connect() immediately sends a SYN packet. If the PHY has not yet
  * negotiated the link, lwIP has no route and returns ERR_RTE (-4).
  * A TCP Server is immune to this because tcp_bind()/tcp_listen() are
  * purely internal and do not transmit any packets.
  *
  * If the link is not yet ready, a 2-second lwIP timer is scheduled to
  * retry automatically - no changes required in main.c.
  */
void tcp_client_init(void)
{
  printf("\n========================================\r\n");
  printf("TCP CLIENT INITIALIZATION STARTED\r\n");
  printf("========================================\r\n");

  /* CRITICAL: Check Ethernet link state BEFORE attempting tcp_connect().
   *
   * Unlike tcp_bind()/tcp_listen() which only set up internal lwIP state,
   * tcp_connect() immediately tries to TRANSMIT a SYN packet. If the PHY
   * link (e.g. LAN8742) is still auto-negotiating, lwIP returns ERR_RTE (-4)
   * because there is no active route to send the packet on.
   */
  if (!netif_is_link_up(&gnetif))
  {
    printf("[WARN] Ethernet link is not yet UP. Scheduling retry in 2 seconds...\r\n");
    printf("========================================\r\n\n");
    /* Schedule a single-shot retry via the lwIP timer (no blocking delay!) */
    sys_timeout(2000, tcp_client_retry_timer, NULL);
    return;
  }

  printf("[INFO] Ethernet link is UP. Proceeding with connection.\r\n");

  /* 1. Create new TCP PCB (same as server) */
  struct tcp_pcb *tpcb;
  tpcb = tcp_new();

  if (tpcb == NULL)
  {
    printf("[ERROR] Failed to create new TCP PCB\r\n");
    return;
  }
  printf("[INFO] TCP PCB created successfully\r\n");

  /* Allocate memory for client structure */
  es_client = (struct tcp_client_struct *)mem_malloc(sizeof(struct tcp_client_struct));

  if (es_client == NULL)
  {
    printf("[ERROR] Failed to allocate memory for client structure\r\n");
    memp_free(MEMP_TCP_PCB, tpcb);
    return;
  }
  printf("[INFO] Memory allocated for client structure\r\n");

  /* Initialize client structure */
  es_client->state = ES_NONE;
  es_client->pcb = tpcb;
  es_client->retries = 0;
  es_client->p = NULL;

  /* 2. Set up server IP address */
  ip_addr_t server_ip;
  IP_ADDR4(&server_ip, TCP_SERVER_IP_ADDR0, TCP_SERVER_IP_ADDR1,
           TCP_SERVER_IP_ADDR2, TCP_SERVER_IP_ADDR3);

  printf("[INFO] Connecting to server: %d.%d.%d.%d:%d\r\n",
         TCP_SERVER_IP_ADDR0, TCP_SERVER_IP_ADDR1,
         TCP_SERVER_IP_ADDR2, TCP_SERVER_IP_ADDR3,
         TCP_SERVER_PORT);

  /* Pass client structure as argument to callbacks */
  tcp_arg(tpcb, es_client);

  /* 3. Connect to server - KEY DIFFERENCE FROM SERVER */
  /* tcp_connect() initiates a connection to remote server.
     When connection is established, tcp_client_connected() callback is called */
  err_t err = tcp_connect(tpcb, &server_ip, TCP_SERVER_PORT, tcp_client_connected);

  if (err == ERR_OK)
  {
    printf("[INFO] Connection initiated successfully\r\n");
    es_client->state = ES_CONNECTING;
    printf("[INFO] Client state: %s\r\n", get_client_state_name(es_client->state));

    /* 4. Set error callback - called if connection fails */
    tcp_err(tpcb, tcp_client_error);
    printf("[INFO] Error callback registered\r\n");

    printf("========================================\r\n");
    printf("Waiting for connection to establish...\r\n");
    printf("========================================\r\n\n");
  }
  else
  {
    printf("[ERROR] Failed to initiate connection. Error code: %d\r\n", err);

    /* Clean up on failure */
    if (es_client != NULL)
    {
      mem_free(es_client);
      es_client = NULL;
    }
    memp_free(MEMP_TCP_PCB, tpcb);
  }
}

/**
  * @brief  Callback function called when connection is established
  * @param  arg: pointer to client structure
  * @param  tpcb: pointer to TCP PCB
  * @param  err: error status
  * @retval err_t: error code
  *
  * @note   This is the CLIENT EQUIVALENT of tcp_server_accept()
  *         - Server: tcp_accept() callback when client connects
  *         - Client: tcp_connected() callback when server accepts
  *
  * WHAT HAPPENS HERE:
  * 1. Connection successful - update state
  * 2. Set up all other callbacks (recv, sent, poll)
  * 3. Send initial message to server
  */
static err_t tcp_client_connected(void *arg, struct tcp_pcb *tpcb, err_t err)
{
  struct tcp_client_struct *es;

  es = (struct tcp_client_struct *)arg;

  if (err == ERR_OK)
  {
    printf("\n========================================\r\n");
    printf("CONNECTION ESTABLISHED!\r\n");
    printf("========================================\r\n");

    /* Get server information */
    ip4_addr_t server_ip = tpcb->remote_ip;
    uint16_t server_port = tpcb->remote_port;
    char *server_ip_str = ipaddr_ntoa(&server_ip);

    printf("[INFO] Connected to server: %s:%u\r\n", server_ip_str, server_port);

    /* Update state to connected */
    es->state = ES_CONNECTED;
    printf("[INFO] Client state: %s\r\n", get_client_state_name(es->state));

    /* Set up all callbacks - same as server does in accept callback */
    tcp_recv(tpcb, tcp_client_recv);     /* Callback for received data */
    tcp_sent(tpcb, tcp_client_sent);     /* Callback when data is sent */
    tcp_poll(tpcb, tcp_client_poll, 1);  /* Periodic callback (every 1*500ms) */
    /* tcp_err already set in tcp_client_init() */

    printf("[INFO] All callback functions initialized\r\n");

    /* Send initial message to server */
    const char *welcome_msg = "Hello from STM32 TCP Client!\r\n";

    /* Allocate pbuf for the message */
    struct pbuf *p_tx = pbuf_alloc(PBUF_TRANSPORT, strlen(welcome_msg), PBUF_RAM);

    if (p_tx != NULL)
    {
      printf("[INFO] Sending welcome message to server\r\n");

      /* Copy message to pbuf */
      memcpy(p_tx->payload, welcome_msg, strlen(welcome_msg));

      /* Store in client structure */
      es->p = p_tx;

      /* Send the message */
      tcp_client_send(tpcb, es);
    }

    printf("========================================\r\n\n");
    return ERR_OK;
  }
  else
  {
    printf("\n[ERROR] Connection failed with error: %d\r\n", err);

    /* Clean up on connection failure */
    tcp_client_connection_close(tpcb, es);
    return err;
  }
}

/**
  * @brief  Callback function for received data
  * @param  arg: pointer to client structure
  * @param  tpcb: pointer to TCP PCB
  * @param  p: pointer to received pbuf
  * @param  err: error information
  * @retval err_t: error code
  *
  * @note   SAME CONCEPT AS SERVER's tcp_server_recv()
  *         Handles incoming data from the server
  *
  * IMPORTANT SCENARIOS:
  * 1. p == NULL: Server closed the connection
  * 2. p != NULL: Data received - process it
  */
static err_t tcp_client_recv(void *arg, struct tcp_pcb *tpcb, struct pbuf *p, err_t err)
{
  struct tcp_client_struct *es;
  err_t ret_err;

  LWIP_ASSERT("arg != NULL", arg != NULL);

  es = (struct tcp_client_struct *)arg;

  /* Get server information for logging */
  ip4_addr_t server_ip = tpcb->remote_ip;
  uint16_t server_port = tpcb->remote_port;
  char *server_ip_str = ipaddr_ntoa(&server_ip);

  /* SCENARIO 1: Empty frame - server closed connection */
  if (p == NULL)
  {
    printf("\n[RECV] Empty frame received from server [%s:%u]\r\n",
           server_ip_str, server_port);
    printf("[INFO] Server closed connection\r\n");
    printf("[INFO] Current state: %s -> ES_CLOSING\r\n",
           get_client_state_name(es->state));

    es->state = ES_CLOSING;

    if (es->p == NULL)
    {
      /* No data to send, close immediately */
      tcp_client_connection_close(tpcb, es);
    }
    else
    {
      /* Send remaining data before closing */
      tcp_client_send(tpcb, es);
    }
    ret_err = ERR_OK;
  }
  /* SCENARIO 2: Error in reception */
  else if (err != ERR_OK)
  {
    printf("\n[RECV] [ERROR] Reception error from [%s:%u], err: %d\r\n",
           server_ip_str, server_port, err);

    /* Free the pbuf */
    if (p != NULL)
    {
      es->p = NULL;
      pbuf_free(p);
    }
    ret_err = err;
  }
  /* SCENARIO 3: Data received successfully */
  else
  {
    printf("\n[RECV] Data received from server [%s:%u]\r\n",
           server_ip_str, server_port);
    printf("[INFO] Data length: %u bytes\r\n", p->tot_len);
    printf("[INFO] Current state: %s\r\n", get_client_state_name(es->state));

    /* Update state */
    es->state = ES_RECEIVED;

    /* Store the received pbuf */
    es->p = p;

    /* Process the received data */
    tcp_client_handle(tpcb, es);

    ret_err = ERR_OK;
  }

  return ret_err;
}

/**
  * @brief  Callback function for TCP errors
  * @param  arg: pointer to client structure
  * @param  err: error type
  *
  * @note   SAME AS SERVER's tcp_server_error()
  *         Called when fatal error occurs (connection reset, abort, etc.)
  *
  * IMPORTANT: PCB is already freed by LwIP when this is called!
  *            Do NOT call tcp_close() or tcp_abort() here!
  */
static void tcp_client_error(void *arg, err_t err)
{
  struct tcp_client_struct *es;

  es = (struct tcp_client_struct *)arg;

  printf("\n========================================\r\n");
  printf("TCP ERROR CALLBACK\r\n");
  printf("========================================\r\n");
  printf("[ERROR] Connection error occurred, error code: %d\r\n", err);

  if (es != NULL)
  {
    printf("[INFO] Previous state: %s\r\n", get_client_state_name(es->state));

    /* Free any pending pbuf */
    if (es->p != NULL)
    {
      printf("[INFO] Freeing pending pbuf\r\n");
      pbuf_free(es->p);
      es->p = NULL;
    }

    /* Free the client structure */
    printf("[INFO] Freeing client structure\r\n");
    mem_free(es);
    es_client = NULL;
  }

  printf("[INFO] Connection will be re-initiated after delay\r\n");
  printf("========================================\r\n\n");

  /* Note: You might want to schedule reconnection here */
  /* For this example, you can call tcp_client_init() after a delay */
}

/**
  * @brief  Periodic polling callback
  * @param  arg: pointer to client structure
  * @param  tpcb: pointer to TCP PCB
  * @retval err_t: error code
  *
  * @note   SAME AS SERVER's tcp_server_poll()
  *         Called periodically (interval set in tcp_poll() call)
  *         Used to retry sending data or check connection status
  */
static err_t tcp_client_poll(void *arg, struct tcp_pcb *tpcb)
{
  err_t ret_err;
  struct tcp_client_struct *es;

  es = (struct tcp_client_struct *)arg;

  if (es != NULL)
  {
    printf("\n[POLL] Periodic poll callback\r\n");
    printf("[INFO] Client state: %s\r\n", get_client_state_name(es->state));

    if (es->p != NULL)
    {
      printf("[POLL] Pending data found, attempting to send\r\n");

      /* Retry sending data */
      tcp_sent(tpcb, tcp_client_sent);
      tcp_client_send(tpcb, es);
    }
    else
    {
      /* No pending data */
      if (es->state == ES_CLOSING)
      {
        printf("[POLL] Connection in closing state, finalizing close\r\n");
        tcp_client_connection_close(tpcb, es);
      }
    }

    /* Increment retries */
    es->retries++;

    /* Check if too many retries */
    if (es->retries > 10)
    {
      printf("[POLL] [WARN] Too many poll retries, closing connection\r\n");
      tcp_client_connection_close(tpcb, es);
    }

    ret_err = ERR_OK;
  }
  else
  {
    printf("[POLL] [ERROR] NULL client structure, aborting\r\n");
    tcp_abort(tpcb);
    ret_err = ERR_ABRT;
  }

  return ret_err;
}

/**
  * @brief  Callback when data is successfully sent and ACK received
  * @param  arg: pointer to client structure
  * @param  tpcb: pointer to TCP PCB
  * @param  len: length of data acknowledged
  * @retval err_t: error code
  *
  * @note   SAME AS SERVER's tcp_server_sent()
  *         Called when remote (server) acknowledges received data
  */
static err_t tcp_client_sent(void *arg, struct tcp_pcb *tpcb, u16_t len)
{
  struct tcp_client_struct *es;

  LWIP_UNUSED_ARG(len);

  es = (struct tcp_client_struct *)arg;

  /* Reset retry counter since we got ACK */
  es->retries = 0;

  printf("\n[ACK] Received ACK from server for %u bytes\r\n", len);
  printf("[INFO] Client state: %s\r\n", get_client_state_name(es->state));

  if (es->p != NULL)
  {
    printf("[INFO] More data pending, continuing transmission\r\n");

    /* Still have data to send */
    tcp_sent(tpcb, tcp_client_sent);
    tcp_client_send(tpcb, es);
  }
  else
  {
    printf("[INFO] No more data to send\r\n");

    /* If closing and all data sent, close connection */
    if (es->state == ES_CLOSING)
    {
      printf("[INFO] Closing connection as requested\r\n");
      tcp_client_connection_close(tpcb, es);
    }
  }

  return ERR_OK;
}

/**
  * @brief  Send data to server
  * @param  tpcb: pointer to TCP PCB
  * @param  es: pointer to client structure
  *
  * @note   SAME LOGIC AS SERVER's tcp_server_send()
  *         Handles the actual sending of data using tcp_write()
  *
  * KEY POINTS:
  * - Check available send buffer with tcp_sndbuf()
  * - Use tcp_write() to enqueue data
  * - Free pbuf after successful write
  * - Handle ERR_MEM by deferring to poll callback
  */
static void tcp_client_send(struct tcp_pcb *tpcb, struct tcp_client_struct *es)
{
  struct pbuf *ptr;
  err_t wr_err = ERR_OK;

  printf("\n[SEND] Starting data transmission to server\r\n");
  printf("[INFO] Available send buffer: %u bytes\r\n", tcp_sndbuf(tpcb));

  /* Send data while:
     1. No write error
     2. Have data to send
     3. Data fits in send buffer */
  while ((wr_err == ERR_OK) &&
         (es->p != NULL) &&
         (es->p->len <= tcp_sndbuf(tpcb)))
  {
    ptr = es->p;

    printf("[SEND] Sending data chunk: %u bytes\r\n", ptr->len);

    /* Enqueue data for transmission */
    wr_err = tcp_write(tpcb, ptr->payload, ptr->len, TCP_WRITE_FLAG_COPY);

    if (wr_err == ERR_OK)
    {
      u16_t plen;
      u8_t freed;

      plen = ptr->len;
      printf("[SEND] Data enqueued successfully\r\n");

      /* Move to next pbuf in chain */
      es->p = ptr->next;

      if (es->p != NULL)
      {
        printf("[INFO] More data in chain, incrementing reference\r\n");
        pbuf_ref(es->p);
      }
      else
      {
        printf("[INFO] Last chunk sent\r\n");
      }

      /* Free the sent pbuf */
      do
      {
        freed = pbuf_free(ptr);
      }
      while (freed == 0);

      printf("[INFO] Pbuf freed\r\n");

      /* We can read more data now */
      tcp_recved(tpcb, plen);
      printf("[INFO] Receive window updated: %u bytes\r\n", plen);
    }
    else if (wr_err == ERR_MEM)
    {
      printf("[WARN] Low memory, deferring send to poll\r\n");
      es->p = ptr;
    }
    else
    {
      printf("[ERROR] tcp_write failed with error: %d\r\n", wr_err);
    }
  }

  if (es->p == NULL)
  {
    printf("[SEND] All data transmitted successfully\r\n\n");
  }
}

/**
  * @brief  Close TCP connection
  * @param  tpcb: pointer to TCP PCB
  * @param  es: pointer to client structure
  *
  * @note   SAME AS SERVER's tcp_server_connection_close()
  *         Properly closes connection and frees resources
  */
static void tcp_client_connection_close(struct tcp_pcb *tpcb, struct tcp_client_struct *es)
{
  printf("\n========================================\r\n");
  printf("CLOSING TCP CLIENT CONNECTION\r\n");
  printf("========================================\r\n");

  /* Remove all callbacks */
  printf("[INFO] Removing all callbacks\r\n");
  tcp_arg(tpcb, NULL);
  tcp_sent(tpcb, NULL);
  tcp_recv(tpcb, NULL);
  tcp_err(tpcb, NULL);
  tcp_poll(tpcb, NULL, 0);

  /* Delete client structure */
  if (es != NULL)
  {
    printf("[INFO] Freeing client structure\r\n");
    mem_free(es);
    es_client = NULL;
  }

  /* Close TCP connection */
  printf("[INFO] Closing TCP PCB\r\n");
  tcp_close(tpcb);

  printf("[SUCCESS] Connection closed successfully\r\n");
  printf("========================================\r\n\n");
}

/**
  * @brief  Handle received data from server
  * @param  tpcb: pointer to TCP PCB
  * @param  es: pointer to client structure
  *
  * @note   SIMILAR TO SERVER's tcp_server_handle()
  *         Process received data and send response
  *
  * THIS IS WHERE YOU IMPLEMENT YOUR APPLICATION LOGIC!
  * - Parse received data
  * - Process it
  * - Generate response
  * - Send back to server
  */
static void tcp_client_handle(struct tcp_pcb *tpcb, struct tcp_client_struct *es)
{
  printf("\n========================================\r\n");
  printf("HANDLING RECEIVED DATA FROM SERVER\r\n");
  printf("========================================\r\n");

  /* Get server IP and port */
  ip4_addr_t server_ip = tpcb->remote_ip;
  uint16_t server_port = tpcb->remote_port;
  char *server_ip_str = ipaddr_ntoa(&server_ip);

  printf("[INFO] Server: %s:%u\r\n", server_ip_str, server_port);
  printf("[INFO] Client state: %s\r\n", get_client_state_name(es->state));

  /* Extract received data */
  char recv_data[MAX_BUFFER_SIZE];
  memset(recv_data, '\0', MAX_BUFFER_SIZE);

  if (es->p->tot_len < MAX_BUFFER_SIZE)
  {
    strncpy(recv_data, (char *)es->p->payload, es->p->tot_len);
  }

  printf("\n--- DATA FROM SERVER ---\r\n");
  printf("%s", recv_data);
  printf("--- END OF DATA ---\r\n");

  /* Free the received pbuf */
  printf("[INFO] Freeing received pbuf\r\n");
  pbuf_free(es->p);
  es->p = NULL;

  /* Prepare response - echo back with client message */
  char response[MAX_BUFFER_SIZE];
  memset(response, '\0', MAX_BUFFER_SIZE);
  snprintf(response, sizeof(response),
           "Client received: %sClient says: Data processed successfully!\r\n",
           recv_data);

  printf("\n--- RESPONSE TO SERVER ---\r\n");
  printf("%s", response);
  printf("--- END OF RESPONSE ---\r\n");
  printf("[INFO] Response length: %lu bytes\r\n", strlen(response));

  /* Allocate pbuf for response */
  struct pbuf *p_tx = pbuf_alloc(PBUF_TRANSPORT, strlen(response), PBUF_RAM);

  if (p_tx != NULL)
  {
    printf("[INFO] Pbuf allocated for response (%u bytes)\r\n", p_tx->len);

    /* Copy response to pbuf */
    memcpy(p_tx->payload, response, strlen(response));

    /* Store in client structure */
    es->p = p_tx;

    /* Send response */
    printf("[INFO] Sending response to server...\r\n");
    tcp_client_send(tpcb, es);
  }
  else
  {
    printf("[ERROR] Failed to allocate pbuf for response\r\n");
  }

  printf("========================================\r\n\n");
}
