// Base addresses from STM32F7 reference manual
#define PERIPH_BASE       0x40000000UL
#define AHB1PERIPH_BASE   (PERIPH_BASE + 0x00020000UL)
#define RCC_BASE          (AHB1PERIPH_BASE + 0x3800UL)
#define GPIOD_BASE        (AHB1PERIPH_BASE + 0x0C00UL)

#define FLASH_BASE        0x40023C00UL
#define PWR_BASE          0x40007000UL

// Register definitions (as volatile pointers)
#define RCC_AHB1ENR       (*(volatile unsigned int *)(RCC_BASE + 0x30))
#define RCC_CR            (*(volatile unsigned int *)(RCC_BASE + 0x00))
#define RCC_PLLCFGR       (*(volatile unsigned int *)(RCC_BASE + 0x04))
#define RCC_CFGR          (*(volatile unsigned int *)(RCC_BASE + 0x08))
#define RCC_APB1ENR       (*(volatile unsigned int *)(RCC_BASE - 0x4000 + 0x40)) // APB1 base shifted (or define APB1 base properly)

#define FLASH_ACR         (*(volatile unsigned int *)(FLASH_BASE + 0x00))

#define PWR_CR1           (*(volatile unsigned int *)(PWR_BASE + 0x00))
#define PWR_CSR1          (*(volatile unsigned int *)(PWR_BASE + 0x04))

#define GPIOD_MODER       (*(volatile unsigned int *)(GPIOD_BASE + 0x00))
#define GPIOD_ODR         (*(volatile unsigned int *)(GPIOD_BASE + 0x14))
#define GPIOD_OSPEEDR     (*(volatile unsigned int *)(GPIOD_BASE + 0x08))
#define GPIOD_PUPDR       (*(volatile unsigned int *)(GPIOD_BASE + 0x0C))
