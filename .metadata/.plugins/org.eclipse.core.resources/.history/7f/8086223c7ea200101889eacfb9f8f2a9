 *)Flash with OpenOCD:
openocd -f interface/stlink.cfg -f target/stm32f7x.cfg -c "program main.bin verify reset exit 0x08000000"

*/

/*
 With Makefile
 i. make
 ii.openocd -f interface/stlink.cfg -f target/stm32f7x.cfg -c "program main.bin verify reset exit 0x08000000"

 */
#define PERIPH_BASE       0x40000000UL
#define AHB1PERIPH_BASE   (PERIPH_BASE + 0x00020000UL)
#define RCC_BASE          (AHB1PERIPH_BASE + 0x3800UL)
#define GPIOD_BASE        (AHB1PERIPH_BASE + 0x0C00UL)
#define FLASH_BASE        0x40023C00UL
#define PWR_BASE          0x40007000UL

// Registers as volatile pointers
#define RCC_CR            (*(volatile unsigned int *)(RCC_BASE + 0x00)) //pointer and dereference a pointer
#define RCC_PLLCFGR       (*(volatile unsigned int *)(RCC_BASE + 0x04))
#define RCC_CFGR          (*(volatile unsigned int *)(RCC_BASE + 0x08))
#define RCC_AHB1ENR       (*(volatile unsigned int *)(RCC_BASE + 0x30))
#define RCC_APB1ENR       (*(volatile unsigned int *)(RCC_BASE + 0x40))

#define FLASH_ACR         (*(volatile unsigned int *)(FLASH_BASE + 0x00))

#define PWR_CR1           (*(volatile unsigned int *)(PWR_BASE + 0x00))
#define PWR_CSR1          (*(volatile unsigned int *)(PWR_BASE + 0x04))

#define GPIOD_MODER       (*(volatile unsigned int *)(GPIOD_BASE + 0x00))
#define GPIOD_ODR         (*(volatile unsigned int *)(GPIOD_BASE + 0x14))
#define GPIOD_OSPEEDR     (*(volatile unsigned int *)(GPIOD_BASE + 0x08))
#define GPIOD_PUPDR       (*(volatile unsigned int *)(GPIOD_BASE + 0x0C))

// Bit masks
#define RCC_CR_HSEON          (1U << 16)
#define RCC_CR_HSERDY         (1U << 17)
#define RCC_CR_PLLON          (1U << 24)
#define RCC_CR_PLLRDY         (1U << 25)

#define RCC_PLLCFGR_PLLSRC_HSE (1U << 22)

#define RCC_CFGR_SW_PLL       (0x2)
#define RCC_CFGR_SWS_PLL      (0x8)
#define RCC_CFGR_SW           (0x3)

#define RCC_AHB1ENR_GPIODEN   (1U << 3)
#define RCC_APB1ENR_PWREN     (1U << 28)

#define FLASH_ACR_LATENCY_7WS (7U << 0)
#define FLASH_ACR_PRFTEN      (1U << 8)
#define FLASH_ACR_ARTEN       (1U << 9)

#define PWR_CR1_ODEN          (1U << 16)
#define PWR_CR1_ODSWEN        (1U << 17)
#define PWR_CSR1_ODRDY        (1U << 16)
#define PWR_CSR1_ODSWRDY      (1U << 17)

void delay(volatile unsigned int count) {
    while (count--) {
        __asm__("nop");
    }
}

void SystemClock_Config(void) {
    // Enable HSE
    RCC_CR |= RCC_CR_HSEON;
    while (!(RCC_CR & RCC_CR_HSERDY));

    // Enable Power interface clock
    RCC_APB1ENR |= RCC_APB1ENR_PWREN;

    // Enable Overdrive
    PWR_CR1 |= PWR_CR1_ODEN;
    while (!(PWR_CSR1 & PWR_CSR1_ODRDY));

    PWR_CR1 |= PWR_CR1_ODSWEN;
    while (!(PWR_CSR1 & PWR_CSR1_ODSWRDY));

    // Configure Flash latency and enable prefetch/art accelerator
    FLASH_ACR = FLASH_ACR_LATENCY_7WS | FLASH_ACR_PRFTEN | FLASH_ACR_ARTEN;

    // Configure PLL (PLLM=25, PLLN=432, PLLP=2, PLLQ=9, source = HSE)
    RCC_PLLCFGR = (25 << 0) | (432 << 6) | (0 << 16) | RCC_PLLCFGR_PLLSRC_HSE | (9 << 24);

    // Enable PLL
    RCC_CR |= RCC_CR_PLLON;
    while (!(RCC_CR & RCC_CR_PLLRDY));

    // Configure clock dividers and switch to PLL
    RCC_CFGR = (0 << 4) |    // HPRE: no division
               (5 << 10) |   // PPRE1: divide by 4
               (4 << 13) |   // PPRE2: divide by 2
               RCC_CFGR_SW_PLL;

    while ((RCC_CFGR & (0xC)) != RCC_CFGR_SWS_PLL);
}

void MX_GPIO_Init(void) {
    // Enable GPIOD clock
    RCC_AHB1ENR |= RCC_AHB1ENR_GPIODEN;

    // Configure PD5 as output (01)
    GPIOD_MODER &= ~(3U << (2 * 5));
    GPIOD_MODER |= (1U << (2 * 5));

    // Medium speed
    GPIOD_OSPEEDR &= ~(3U << (2 * 5));
    GPIOD_OSPEEDR |= (1U << (2 * 5));

    // No pull-up, no pull-down
    GPIOD_PUPDR &= ~(3U << (2 * 5));
}

int main(void) {
    SystemClock_Config();
    MX_GPIO_Init();

    while (1) {
        GPIOD_ODR &= ~(1U << 5);  // LED ON
        delay(270000000);
        GPIOD_ODR |= (1U << 5);   // LED OFF
        delay(270000000);
    }
}
