 # Compile C file
arm-none-eabi-gcc -mcpu=cortex-m7 -mthumb -O0 -g -c main.c -o main.o

# Compile startup (vector table) and syscalls
arm-none-eabi-gcc -mcpu=cortex-m7 -mthumb -O0 -g -c startup_stm32f746xx.s -o startup_stm32f746xx.o
arm-none-eabi-gcc -mcpu=cortex-m7 -mthumb -O0 -g -c syscalls.c -o syscalls.o

# Link everything with your linker script
