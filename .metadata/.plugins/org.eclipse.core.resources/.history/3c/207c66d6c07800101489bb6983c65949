/**
  * @brief System Clock Configuration
  * @retval None
  */
void start()
{
	clk_high;
	HAL_Delay(1);
	sda_high;
	HAL_Delay(1);
	sda_low;
	HAL_Delay(1);
	clk_low;
	HAL_Delay(1);

}
void stop()
{
	sda_low;
	HAL_Delay(1);
	clk_high;
	HAL_Delay(1);
	sda_high;
	HAL_Delay(1);
}

bool write_byte(uint8_t byte, bool do_start, bool do_stop)
{
	uint8_t ack=0;
	if(do_start) start();
		uint8_t i;
		for(i=0; i<8; i++)
		{
			write_bit( writeData & 0x80);
			byte <<=1;
		}
		ack= !read_bit();
		if(do_stop) stop();
		return ack;

}
void read_byte(bool ack, bool do_stop)
{
	uint8_t byte = 0;

		for (uint8_t i = 0; i < 8; i++)
		{
			byte <<= 1;
			byte |= read_bit();
		}

		// Send ACK/NACK
		write_bit(!ack);  // ack = 1 → send ACK (pull SDA low), ack = 0 → send NACK

		if (do_stop)
			stop();

		return byte;
}
void write_bit(uint8_t bit)
{
	if (bit)
		sda_high;
	else
		sda_low;

	i2c_delay();
	clk_high;
	i2c_delay();
	clk_low;
	i2c_delay();
}

uint8_t read_bit(void)
{
	uint8_t bit;

	sda_high;  // Release SDA (input mode simulated)
	i2c_delay();

	clk_high;
	i2c_delay();

	bit = (GPIOB->IDR >> 7) & 0x01;  // Read SDA line (PB7)

	clk_low;
	i2c_delay();

	return bit;
}

