#include "lwip/pbuf.h"
#include "lwip/udp.h"
#include "lwip/tcp.h"
#include "stdio.h"
#include "string.h"
#include "udp_client.h"


void udp_receive_callback(void *arg, struct udp_pcb *upcb, struct pbuf *p, const ip_addr_t *addr, u16_t port);
static void udpClient_send(const char *message);

struct udp_pcb *upcb;
char buffer[100];


void udpClient_connect(void)
{
    err_t err;

    /* 1. Create a new UDP control block  */
    upcb = udp_new();

    /* Bind the block to module's IP and port */
    ip_addr_t myIPaddr;
    IP_ADDR4(&myIPaddr, 10, 4, 90, 100);
    udp_bind(upcb, &myIPaddr, 1100);

    /* Configure destination IP address and port */
    ip_addr_t DestIPaddr;
    IP_ADDR4(&DestIPaddr, 10, 4, 90, 58);
    err = udp_connect(upcb, &DestIPaddr, 12);

    if (err == ERR_OK)
    {
    	printf("Client connected! \r\n");
        /* 2. Send "Hello World" message to server */
        udpClient_send("Hello World");

        /* 3. Set a receive callback for the upcb */
        udp_recv(upcb, udp_receive_callback, NULL);
        printf("Receive callback registered\r\n");
    }
}

static void udpClient_send(const char *message)
{
    struct pbuf *txBuf;
    int len = strlen(message);
    err_t err;

    /* Allocate pbuf from pool */
    txBuf = pbuf_alloc(PBUF_TRANSPORT, len, PBUF_RAM);
    printf("Buffer allocated...\r\n");

    if (txBuf != NULL)
    {
        /* Copy data to pbuf */
        pbuf_take(txBuf, message, len);
        printf("Data copied to buffer: '%s'\r\n", message);

        /* Send UDP data */
        err = udp_send(upcb, txBuf);

        if (err == ERR_OK)
		{
			printf("UDP packet sent successfully\r\n");
		}
		else
		{
			printf("ERROR: UDP send failed with error %d\r\n", err);
		}

		/* Free pbuf */
		pbuf_free(txBuf);
		printf("Buffer freed\r\n");
    }
    else
    {
    	printf("Failed to allocate Buffer\r\n)");
    }
}


void udp_receive_callback(void *arg, struct udp_pcb *upcb, struct pbuf *p, const ip_addr_t *addr, u16_t port)
{
    printf("=== UDP packet received ===\r\n");
    printf("From: %d.%d.%d.%d:%d\r\n",
           ip4_addr1(addr), ip4_addr2(addr), ip4_addr3(addr), ip4_addr4(addr), port);
    printf("Length: %d bytes\r\n", p->len);

    /* Copy the data from the pbuf */
    strncpy(buffer, (char *)p->payload, p->len);
    buffer[p->len] = '\0';  // Ensure null termination

    printf("Data: '%s'\r\n", buffer);

    /* Free receive pbuf */
    pbuf_free(p);
    printf("=== Packet processed ===\r\n");
}

