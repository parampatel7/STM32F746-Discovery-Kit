#include "lwip/pbuf.h"
#include "lwip/udp.h"
#include "lwip/tcp.h"
#include "stdio.h"
#include "string.h"
#include "udp_client.h"


void udp_receive_callback(void *arg, struct udp_pcb *upcb, struct pbuf *p, const ip_addr_t *addr, u16_t port);
static void udpClient_send(const char *message);

struct udp_pcb *upcb;
char buffer[100];


void udpClient_connect(void)
{
    err_t err;
    if (upcb != NULL)
    {
        printf("UDP client already initialized!\r\n");
        return;
    }

    /* 1. Create a new UDP control block  */
    upcb = udp_new();

    /* Bind the block to module's IP and port */
    ip_addr_t myIPaddr;
    IP_ADDR4(&myIPaddr, 10, 4, 90, 100);
    err =udp_bind(upcb, &myIPaddr, 1100);
    if (err != ERR_OK)
    {
        printf("ERROR: UDP bind failed with error %d\r\n", err);
        udp_remove(upcb);
        upcb = NULL;
        return;
    }
    /* Configure destination IP address and port */
    ip_addr_t DestIPaddr;
    IP_ADDR4(&DestIPaddr, 10, 4, 90, 58);
    err = udp_connect(upcb, &DestIPaddr, 12);

    if (err == ERR_OK)
    {
    	printf("Client connected! \r\n");

        /* 2. Set a receive callback for the upcb */
        udp_recv(upcb, udp_receive_callback, NULL);
        printf("Receive callback registered\r\n");

        /* 3. Send "Hello World" message to server */
        udpClient_send("Hello World");

    }
}

static void udpClient_send(const char *message)
{
    struct pbuf *txBuf;
    int len = strlen(message);
    err_t err;

    if (upcb == NULL)
    {
        printf("ERROR: UDP client not initialized\r\n");
        return;
    }

    /* Allocate pbuf from pool */
    txBuf = pbuf_alloc(PBUF_TRANSPORT, len, PBUF_RAM);
    if (txBuf != NULL)
    {
        printf("Buffer allocated (%d bytes)\r\n", len);

        /* Copy data to pbuf */
        pbuf_take(txBuf, message, len);
        printf("Data copied to buffer: '%s'\r\n", message);

        /* Send UDP data */
        err = udp_send(upcb, txBuf);

        if (err == ERR_OK)
        {
            printf("UDP packet sent successfully\r\n");
        }
        else
        {
            printf("ERROR: UDP send failed with error %d\r\n", err);
        }

        /* Free pbuf */
        pbuf_free(txBuf);
        printf("Buffer freed\r\n");
    }
    else
    {
        printf("ERROR: Failed to allocate buffer\r\n");
    }
}


void udp_receive_callback(void *arg, struct udp_pcb *upcb, struct pbuf *p, const ip_addr_t *addr, u16_t port)
{
    if (p == NULL) return;

    printf("\r\n=== UDP PACKET RECEIVED ===\r\n");
    printf("From: %d.%d.%d.%d:%d\r\n",
           ip4_addr1(addr), ip4_addr2(addr), ip4_addr3(addr), ip4_addr4(addr), port);
    printf("Length: %d bytes\r\n", p->len);

    int copy_len = (p->len < sizeof(buffer) - 1) ? p->len : sizeof(buffer) - 1;
    strncpy(buffer, (char *)p->payload, copy_len);
    buffer[copy_len] = '\0';

    printf("Data received: '%s'\r\n", buffer);
    printf("===========================\r\n\r\n");

    /* Echo back */
    udp_send(upcb, p);
    printf("Data echoed back to sender\r\n");

    pbuf_free(p);
}
