void AD7779_WriteRegister(uint8_t reg, uint8_t data)
{
    uint8_t tx[2];
    tx[0] = 0x00 | (reg & 0x3F);  // Write command
    tx[1] = data;

    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12, GPIO_PIN_RESET); // CS LOW
    HAL_SPI_Transmit(&hspi2, tx, 2, HAL_MAX_DELAY);
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12, GPIO_PIN_SET);   // CS HIGH
}

void AD7779_ReadRegister(uint8_t reg, uint8_t* data)
{
    uint8_t tx = 0x40 | (reg & 0x3F);  // Read command
    uint8_t rx = 0;

    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12, GPIO_PIN_RESET); // CS LOW
    HAL_SPI_Transmit(&hspi2, &tx, 1, HAL_MAX_DELAY);
    HAL_SPI_Receive(&hspi2, &rx, 1, HAL_MAX_DELAY);
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12, GPIO_PIN_SET);   // CS HIGH

    *data = rx;
}
void AD7779_Reset(void)
{
    HAL_GPIO_WritePin(GPIOF, GPIO_PIN_6, GPIO_PIN_RESET);  // RESET LOW
    HAL_Delay(10);  // 10ms
    HAL_GPIO_WritePin(GPIOF, GPIO_PIN_6, GPIO_PIN_SET);    // RESET HIGH
    HAL_Delay(10);  // Wait after reset
}

